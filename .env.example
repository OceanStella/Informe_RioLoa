# Correo. EMAIL_MODE=mock evita SMTP en desarrollo.
EMAIL_MODE=mock
SMTP_USER=
SMTP_PASS=

# Parámetros: vacío = config/local-config.json; firestore = Firestore informeOctavioConfig/main.
CONFIG_STORAGE=
# Bucket de los PDF históricos. Vacío = carpeta local .local-reports.
CONFIG_BUCKET=
# Objeto origen de scripts/migrate-config-to-firestore.ts (respaldo, ya no se lee en ejecución).
CONFIG_OBJECT=config-v2.json

# Proyecto GCP. En local con emulador: FIRESTORE_EMULATOR_HOST=127.0.0.1:8681
GOOGLE_CLOUD_PROJECT=

# Base del enlace /review/<token> de los correos.
APP_PUBLIC_URL=http://localhost:5173

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Microsoft Entra External ID. Ver docs/auth/MICROSOFT_ENTRA_SETUP.md
AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=
AUTH_SESSION_SECRET=

# Código de acceso temporal del MVP. Solo actúa con AUTH_ENABLED=false.
# El valor real va en Secret Manager; ver docs/auth/AUTH_DISABLED_MVP.md
MVP_ACCESS_ENABLED=false
MVP_ACCESS_CODE=
